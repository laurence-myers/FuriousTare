root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Windows PowerShell 5.1 reads BOM-less scripts using the legacy code page
[*.{cs,ps1,md,sln}]
charset = utf-8-bom

[*.sln]
indent_style = tab

[*.{json,yml,yaml}]
indent_size = 2

# Generated by BepInEx; keep as BepInEx writes them
[BepInEx/config/**]
trim_trailing_whitespace = false
